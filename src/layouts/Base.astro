---
// Page shell for every page: fonts mode, language, alternate-language links, skip link,
// header, main content, footer. Pages pass their route key (and slug) so the language
// toggle and hreflang links point to the same page in the other language.
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/ui';
import { path, asset, langs, type Lang, type RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  slug?: string;
  /** Page title without the site name; omit on the home page */
  title?: string;
  description?: string;
  /** Footer directly under the content (no top margin), e.g. after the pager */
  flushFooter?: boolean;
}
const { lang, routeKey, slug, title, description, flushFooter = false } = Astro.props;
const siteName = t(lang, 'site.name');
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · ${t(lang, 'site.tagline')}`;
// Brand fonts only where HS KL's font license allows it (see public/fonts/brand/README.md)
const brandFonts = import.meta.env.PUBLIC_BRAND_FONTS === 'true';
---
<!doctype html>
<html lang={lang} data-fonts={brandFonts ? 'brand' : 'fallback'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {/* No favicon until the official HS KL mark arrives (DESIGN.md 2.3); empty icon avoids a 404 */}
    <link rel="icon" href="data:," />
    {description && <meta name="description" content={description} />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={path(l, routeKey, slug)} />)}
    <link rel="alternate" hreflang="x-default" href={path('de', routeKey, slug)} />
    {brandFonts && <link rel="stylesheet" href={asset('fonts/brand/brand-fonts.css')} />}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t(lang, 'skip')}</a>
    <Header lang={lang} routeKey={routeKey} slug={slug} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} routeKey={routeKey} flush={flushFooter} />
    {/* Duplex filter for atmospheric images (DESIGN.md 5.3) */}
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <filter id="duplex-blue" color-interpolation-filters="sRGB">
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.2196 1" />
          <feFuncG type="table" tableValues="0.6863 1" />
          <feFuncB type="table" tableValues="0.9922 1" />
        </feComponentTransfer>
      </filter>
    </svg>
  </body>
</html>
