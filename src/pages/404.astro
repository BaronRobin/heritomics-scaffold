---
// 404: one page for the whole site. The URL does not tell us the language, so German comes
// first (default language) and English follows in its own section with lang="en".
import Base from '../layouts/Base.astro';
import { path } from '../i18n/routes';
---
<Base lang="de" routeKey="home" title="Seite nicht gefunden">
  <div class="wrap section">
    <div class="not-found">
      <div class="stack">
        <h1 class="d t-h1">Seite nicht gefunden</h1>
        <p>Diese Seite gibt es nicht oder nicht mehr. Vielleicht hat sich ihre Adresse geändert.</p>
        <a class="btn" href={path('de', 'home')}>Zur Startseite</a>
      </div>
      <section class="stack" lang="en" aria-labelledby="not-found-en">
        <h2 id="not-found-en" class="t-h3">Page not found</h2>
        <p>This page doesn’t exist, or no longer does. Maybe its address has changed.</p>
        <a class="btn" href={path('en', 'home')}>Go to the home page</a>
      </section>
    </div>
  </div>
</Base>

<style>
  .not-found { max-width: var(--measure); display: flex; flex-direction: column; gap: var(--x-2); }
</style>
