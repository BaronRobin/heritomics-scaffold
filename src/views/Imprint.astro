---
// Impressum / Imprint. A PLACEHOLDER for the official HS Kaiserslautern text (docs/PRIVACY.md):
// never write legal text here. Everything in [brackets] waits for the official wording.
// Only "Projekt", "Nachweise" and "Schriften" are our own facts about the site, not legal text.
import ExternalLink from '../components/ExternalLink.astro';
import Surface from '../components/Surface.astro';
import Headline from '../components/Headline.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  de: {
    notice: 'Hier steht später das offizielle Impressum der Hochschule Kaiserslautern. Diese Seite enthält bewusst keinen eigenen Rechtstext.',
    provider: 'Anbieter',
    providerText: '[Offizieller Text der HS Kaiserslautern: Name, Anschrift, Vertretung, Kontakt, Aufsichtsbehörde, Umsatzsteuer-ID]',
    responsible: 'Verantwortlich für den Inhalt',
    responsibleText: '[Name und Anschrift der verantwortlichen Person]',
    project: 'Projekt',
    projectText: 'Creative Science ist ein Modul im Studiengang Virtual Design der Hochschule Kaiserslautern und Teil des Projekts Heritomics.',
    credits: 'Nachweise',
    creditsMedia: 'Fotos und Laborvideo: Dr. Patrick Jung, XCEL – Extreme Cryptogam Ecology Lab, Hochschule Kaiserslautern',
    creditsResearch: 'Forschungsinhalte und Zitate:',
    creditsModel: 'Das 3D-Modell ist ein Platzhalter. Es wird per Programmcode erzeugt und zeigt keine Messdaten.',
    fonts: 'Schriften',
    fontsText: 'Poppins, unter der SIL Open Font License 1.1, direkt von dieser Website geladen.',
  },
  en: {
    notice: 'The official imprint of Hochschule Kaiserslautern will appear here. This page deliberately contains no legal text of its own.',
    provider: 'Provider',
    providerText: '[Official text from HS Kaiserslautern: name, address, legal representative, contact, supervisory authority, VAT ID]',
    responsible: 'Responsible for the content',
    responsibleText: '[Name and address of the person responsible]',
    project: 'Project',
    projectText: 'Creative Science is a module in the Virtual Design programme at Hochschule Kaiserslautern and part of the Heritomics project.',
    credits: 'Credits',
    creditsMedia: 'Photos and lab video: Dr. Patrick Jung, XCEL – Extreme Cryptogam Ecology Lab, Hochschule Kaiserslautern',
    creditsResearch: 'Research content and quotes:',
    creditsModel: 'The 3D model is a placeholder. It is generated by code and shows no measured data.',
    fonts: 'Fonts',
    fontsText: 'Poppins, under the SIL Open Font License 1.1, loaded directly from this website.',
  },
};
const c = copy[lang];
---
<div class="wrap section">
  <div class="legal">
    <Headline level={1}>{t(lang, 'footer.imprint')}</Headline>
    <Surface color="green">
      <p><strong>{t(lang, 'placeholder')}.</strong> {c.notice}</p>
    </Surface>
    <section class="stack" aria-labelledby="imprint-provider">
      <h2 id="imprint-provider" class="t-h3">{c.provider}</h2>
      <p>{c.providerText}</p>
    </section>
    <section class="stack" aria-labelledby="imprint-responsible">
      <h2 id="imprint-responsible" class="t-h3">{c.responsible}</h2>
      <p>{c.responsibleText}</p>
    </section>
    <section class="stack" aria-labelledby="imprint-project">
      <h2 id="imprint-project" class="t-h3">{c.project}</h2>
      <p>{c.projectText}</p>
    </section>
    <section class="stack" aria-labelledby="imprint-credits">
      <h2 id="imprint-credits" class="t-h3">{c.credits}</h2>
      <p>
        {c.creditsMedia} (<ExternalLink href="https://www.instagram.com/selectedplants/" lang={lang}>@selectedplants</ExternalLink>).{' '}
        {c.creditsResearch} <ExternalLink href="https://www.selectedplants.de/" lang={lang}>selectedplants.de</ExternalLink>.
      </p>
      <p>{c.creditsModel}</p>
    </section>
    <section class="stack" aria-labelledby="imprint-fonts">
      <h2 id="imprint-fonts" class="t-h3">{c.fonts}</h2>
      <p>{c.fontsText}</p>
    </section>
  </div>
</div>

<style>
  .legal { max-width: var(--measure); display: flex; flex-direction: column; gap: var(--x); }
</style>
